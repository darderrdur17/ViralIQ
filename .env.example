# ViralIQ — optional integration credentials
# The historical-data MVP runs with NO credentials. Every variable below is
# optional and only needed if you enable the corresponding connector.
#
# Copy to .env and fill in only what you are authorised to use.

# ---- Hugging Face ----
# Public dataset reads work anonymously. A token only helps with rate limits.
HF_TOKEN=

# ---- TikTok Research API ----
# Requires approved researcher eligibility. Do not attempt to bypass approval.
TIKTOK_RESEARCH_CLIENT_KEY=
TIKTOK_RESEARCH_CLIENT_SECRET=

# ---- TikTok Display API ----
# Requires a creator to authorise your application. Never scrape around this.
TIKTOK_DISPLAY_CLIENT_KEY=
TIKTOK_DISPLAY_CLIENT_SECRET=

# ---- Licensed data provider (optional commercial route) ----
DATASOCIAL_API_KEY=

# ---- Application ----
VIRALIQ_LOG_LEVEL=INFO
VIRALIQ_HF_REPO=datasocial/tiktok-5.6B-videos
